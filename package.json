{
  "name": "gatsby-starter-react-bootstrap",
  "private": true,
  "description": "A starter that includes and configures react-bootstrap and react-icons, along with SASS handling. ",
  "version": "0.1.0",
  "author": "Billy Jacoby <billyjacoby@gmail.com>",
  "dependencies": {
    "@pureartisan/simple-i18n": "^1.6.1",
    "@turf/circle": "^6.5.0",
    "bootstrap": "^5.3.0",
    "clsx": "^2.1.0",
    "cpal-components": "^1.4.3",
    "framer-motion": "^11.0.0",
    "gatsby": "^5.13.0",
    "gatsby-plugin-image": "^3.13.0",
    "gatsby-plugin-google-gtag": "^5.13.0",
    "gatsby-plugin-manifest": "^5.13.0",
    "gatsby-plugin-offline": "^6.13.0",
    "gatsby-plugin-react-helmet": "^6.13.0",
    "gatsby-plugin-sass": "^6.13.0",
    "gatsby-plugin-sharp": "^5.13.0",
    "gatsby-source-filesystem": "^5.13.0",
    "gatsby-transformer-json": "^5.13.0",
    "gatsby-transformer-sharp": "^5.13.0",
    "intersection-observer": "^0.12.2",
    "sass": "^1.69.0",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-bootstrap": "^2.10.0",
    "react-dom": "^18.2.0",
    "react-helmet": "^6.1.0",
    "react-icons": "^5.0.0",
    "react-joyride": "^2.8.0",
    "react-intersection-observer": "^9.8.0",
    "react-map-gl": "^7.1.0",
    "react-scroll": "^1.9.0"
  },
  "devDependencies": {
    "gh-pages": "^6.1.0",
    "prettier": "^3.2.0"
  },
  "optionalDependencies": {
    "fsevents": "*"
  },
  "keywords": [
    "gatsby"
  ],
  "license": "MIT",
  "scripts": {
    "build": "gatsby build",
    "develop": "gatsby clean && gatsby develop -H 0.0.0.0 -p 8000",
    "format": "prettier --write src/**/*.{js,jsx}",
    "start": "npm run develop && npm run serve",
    "serve": "gatsby serve",
    "test": "echo \"Write tests! -> https://gatsby.dev/unit-testing\"",
    "deploy": "gatsby build --prefix-paths && gh-pages -d public",
    "clean": "gatsby clean"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gatsbyjs/gatsby-starter-default"
  },
  "bugs": {
    "url": "https://github.com/gatsbyjs/gatsby/issues"
  },
  "homepage": "https://billyjacoby.github.io/gatsby-react-bootstrap-starter/",
  "overrides": {
    "node-sass": "npm:sass@^1.69.0",
    "cpal-components": {
      "react": "$react"
    }
  }
}
